<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#E5DDC9"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvIngredientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomatoes"
            android:textColor="#60412B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIngredientDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="5 Items"
            android:textColor="#8A7867"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvExpiryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Expires: 14/9/2026"
            android:textColor="#9B8B7A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvExpiryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#D7C9B8"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="EXPIRING SOON"
            android:textColor="#60412B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditIngredient"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#60412B"
                app:backgroundTint="#D7C9B8"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnDeleteIngredient"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#60412B"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>